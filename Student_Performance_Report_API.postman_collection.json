          "raw": "{\n  \"studentId\": 1,\n  \"subjectId\": 1,\n  \"examId\": 1,\n  \"marksObtained\": 95,\n  \"totalMarks\": 100,\n  \"percentage\": 95.0,\n  \"grade\": \"A\",\n  \"examDate\": \"2025-03-20\",\n  \"reportDate\": \"2025-03-21\",\n  \"academicYear\": 2025,\n  \"remarks\": \"Outstanding performance in Mathematics\"\n}"
        },
        "url": {
          "raw": "http://localhost:9091/api/student-performance",
          "protocol": "http",
          "host": ["localhost"],
          "port": "9091",
          "path": ["api", "student-performance"]
        }
      }
    },
