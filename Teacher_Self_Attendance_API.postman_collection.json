{
  "info": {
    "_postman_id": "fd9ad7f4-8489-4daf-af7c-b3d53c8ba601",
    "name": "Teacher Self Attendance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Teacher self attendance, leave history, and admin leave approval APIs."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9091" },
    { "key": "facultyId", "value": "1" },
    { "key": "schoolId", "value": "1" },
    { "key": "leaveId", "value": "1" }
  ],
  "item": [
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/dashboard"
      }
    },
    {
      "name": "Check In",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"lateNote\": \"Traffic delay\"\n}" },
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/check-in"
      }
    },
    {
      "name": "Check Out",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"workSummary\": \"Completed worksheets review and parent calls.\"\n}" },
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/check-out"
      }
    },
    {
      "name": "Apply Leave",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"leaveType\": \"CASUAL\",\n  \"fromDate\": \"2026-05-15\",\n  \"toDate\": \"2026-05-16\",\n  \"reason\": \"Personal work\"\n}"
        },
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/leave/apply"
      }
    },
    {
      "name": "Leave History (All)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/leave/history"
      }
    },
    {
      "name": "Leave History (By Status)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher/self-attendance/{{facultyId}}/leave/history?status=APPLIED"
      }
    },
    {
      "name": "Admin List Leave Requests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher/self-attendance/admin/leave-requests?schoolId={{schoolId}}"
      }
    },
    {
      "name": "Admin List Leave Requests (By Status)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher/self-attendance/admin/leave-requests?schoolId={{schoolId}}&status=APPLIED"
      }
    },
    {
      "name": "Admin Approve Leave",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\",\n  \"adminName\": \"School Admin\"\n}"
        },
        "url": "{{baseUrl}}/api/teacher/self-attendance/admin/leave-requests/{{leaveId}}/status"
      }
    },
    {
      "name": "Admin Reject Leave",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"REJECTED\",\n  \"adminName\": \"School Admin\",\n  \"rejectionReason\": \"Insufficient substitute coverage\"\n}"
        },
        "url": "{{baseUrl}}/api/teacher/self-attendance/admin/leave-requests/{{leaveId}}/status"
      }
    }
  ]
}
